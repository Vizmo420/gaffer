# Skopiuj ten plik do .env i uzupełnij wartościami z rejestracji aplikacji CHPP.
# hattrick.org -> Moje Hattrick -> Ustawienia -> CHPP (Zarządzaj aplikacjami CHPP)
# Widoczne dopiero po zalogowaniu na konto Hattrick.

CHPP_CONSUMER_KEY=
CHPP_CONSUMER_SECRET=

# --- Poniższe tylko dla trybu server.js (opcjonalny Express, nie CLI) ---
# W trybie CLI ("oob") NIE są potrzebne.
APP_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=zmien-mnie-na-losowy-ciag
